# Copie para .env (o .env está no .gitignore e nunca vai para o GitHub).
# Banco único de produção no Turso — ver docs/06-operacao.md
TURSO_DATABASE_URL=libsql://germani-prospect-<sua-org>.turso.io
# Token ADMINISTRATIVO (acesso total). Só na máquina do administrador e no Secret do GitHub.
TURSO_AUTH_TOKEN=
# Nome gravado em importacoes.executado_por / auditoria
GERMANI_EXECUTADO_POR=
